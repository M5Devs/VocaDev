{
  "name": "@M5Devs/vocadev-vscode-theme",
  "displayName": "VocaDev Miku Theme",
  "description": "Developer customization theme inspired by Vocaloid Hatsune Miku",
  "version": "0.1.0",
  "publisher": "vocadev",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "miku",
    "vocaloid",
    "hatsune-miku",
    "cyan",
    "dark-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "VocaDev Miku Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/miku-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/M5Devs/VocaDev.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));p.name='vocadev-vscode-theme';fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');try{require('child_process').execSync('vsce package --no-dependencies -o vocadev-vscode-theme-'+p.version+'.vsix',{stdio:'inherit'})}finally{p.name='@M5Devs/vocadev-vscode-theme';fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n')}\"",
    "package": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));p.name='vocadev-vscode-theme';fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');try{require('child_process').execSync('vsce package --no-dependencies -o vocadev-vscode-theme-'+p.version+'.vsix',{stdio:'inherit'})}finally{p.name='@M5Devs/vocadev-vscode-theme';fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n')}\"",
    "vscode:prepublish": "pnpm --filter @M5Devs/vocadev-core build"
  },
  "license": "MIT"
}
