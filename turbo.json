{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "themes/**", "*.vsix", "build/distributions/**"]
    },
    "jetbrains:gradle-build": {
      "dependsOn": ["^build"],
      "outputs": ["build/distributions/**", "build/libs/**"]
    },
    "neovim:package": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
